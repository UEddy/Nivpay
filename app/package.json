{
  "name": "nivpay-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p api/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:live": "node --test src/lib/permit.live-test.ts"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@fontsource/besley": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
