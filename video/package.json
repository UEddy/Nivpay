{
  "name": "nivpay-video",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "video:studio": "remotion studio --no-open",
    "video:render": "node scripts/render.ts",
    "video:render:agora": "node scripts/render-video.ts agora-bounty",
    "video:render:demo": "node scripts/render-video.ts technical-demo",
    "video:render:x": "node scripts/render-video.ts x-launch",
    "video:privacy-check": "node scripts/privacy-check.ts",
    "video:denylist-lint": "node scripts/denylist-lint.ts",
    "video:check": "npm run typecheck && npm test && node scripts/check.ts"
  },
  "dependencies": {
    "@fontsource/besley": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@tesseract.js-data/eng": "1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
