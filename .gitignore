# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Broadcast receipts.
#
# Chain 10143 (Monad testnet) is DELIBERATELY NOT IGNORED. The receipt from a
# real deploy is committed on purpose, as provenance: it records the address,
# the exact constructor arguments and the transaction hash for a contract that
# has no owner and cannot be upgraded, so the deployment is the only thing there
# is to point at. Please do not "fix" this by ignoring it. See the README
# section "Broadcast receipts are committed on purpose".
#
# Local runs and simulations are ignored, because they are noise.
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs. forge doc writes generated output under docs/, so ignore everything
# there except the hand written Markdown and the design comps.
docs/*
!docs/*.md
!docs/design/

# Dotenv file
.env
.env.*
!.env.example

# Keys and credentials. None belong in this repository: the deployer key lives
# in an encrypted keystore under ~/.foundry/keystores, and the funder key only
# in the Vercel project's environment variables.
keystore/
keystores/
*.keystore
UTC--*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.vercel/
